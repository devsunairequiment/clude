TZ=America/Mexico_City
PUID=1000
PGID=1000
# Carpeta con tus películas/series/música para Jellyfin
MEDIA_PATH=/srv/media
# Carpeta donde se guardan los datos de todos los servicios
DATA_PATH=/srv/homelab
# Pon tu dominio si tienes uno (p. ej. vault.midominio.com)
VAULTWARDEN_DOMAIN=https://vault.local
# VPN WireGuard propia (opcional; por defecto se usa Tailscale)
# ENABLE_WG=1
# IP pública o dominio DDNS para la VPN
WG_HOST=cambia-por-tu-ip-publica-o-ddns
# Carpeta donde Immich guarda tus fotos y vídeos
PHOTOS_PATH=/srv/homelab/immich/library
# Versión mayor de Immich (actualízala a mano leyendo las notas de versión)
IMMICH_VERSION=v3
